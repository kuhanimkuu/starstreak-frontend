# Cloudflare Pages response headers for every page.
# - HSTS: browsers only ever use HTTPS for starstreak.org.
# - frame-ancestors / X-Frame-Options: no other site can load ours in a frame
#   (clickjacking on /ops, /business and the web app).
# - object-src / base-uri: block plugin content and <base> tag hijacking.
# - Permissions-Policy: the site never uses the camera, microphone, payment
#   or USB APIs, so they're switched off.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Private areas: never listed by search engines, and links clicked inside
# them don't tell the other site where the visitor came from.
/ops
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
/ops/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
/business
  X-Robots-Tag: noindex, nofollow
/business/*
  X-Robots-Tag: noindex, nofollow

# Built files have content hashes in their names, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
